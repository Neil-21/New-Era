{
  "name": "new-era",
  "version": "0.1.0",
  "description": "Obsidian-style markdown vault + Notion-style databases, one app.",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "esbuild src/renderer/app.js --bundle --format=esm --outfile=src/renderer.bundle.js",
    "watch": "npm run build -- --watch",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language-data": "^6.5.1",
    "codemirror": "^6.0.1"
  }
}
